# ===================================================
# CONFIGURAÇÃO LOCAWEB - Betinalimpeza.com.br
# ===================================================
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env
# 2. Preencha as valores reais
# 3. Nunca commite .env (adicione em .gitignore)
#
# ===================================================

# 🌐 CONFIGURAÇÃO FTP (Sempre disponível)
BETINA_LOCAWEB_IP=187.45.240.49
BETINA_LOCAWEB_HOST=187.45.240.49
BETINA_LOCAWEB_USER=betinalimpeza
BETINA_LOCAWEB_PASSWORD=seu_senha_aqui

# 🔐 CONFIGURAÇÃO SSH (Ativar no painel: 3 horas)
# Passos para ativar SSH:
#   1. https://painelhospedagem.locaweb.com.br/dashboard/8291801
#   2. Menu: Hospedagem → Ambientes → Acesso
#   3. Ativar "SSH" (checkbox)
#   4. Confirmar e aguardar
#   5. Definir BETINA_LOCAWEB_SSH_ENABLED=true

BETINA_LOCAWEB_SSH_USER=betinalimpeza
BETINA_LOCAWEB_SSH_KEY=~/.ssh/id_rsa_betinalimpeza
BETINA_LOCAWEB_SSH_PORT=22
BETINA_LOCAWEB_SSH_ENABLED=false

# ⚠️  IMPORTANTE: IP DINÂMICO
# O IP público pode mudar periodicamente.
# Se SSH falhar, execute:
#   nslookup betinalimpeza.com.br
# E atualize BETINA_LOCAWEB_IP com o resultado novo.
